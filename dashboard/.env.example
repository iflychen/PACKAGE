# =============================================================================
#  SPC Dashboard 執行時環境變數
#  ---------------------------------------------------------------------------
#  這三個都只在伺服器端讀取(沒有 NEXT_PUBLIC_ 開頭的)，所以不會被編進
#  前端 bundle，也代表同一個 image 換一份 .env 就能換環境，不必重 build。
#
#  本機開發：複製成 .env.local
#  容器執行：複製成 .env，用 docker run --env-file .env 或 compose env_file
# =============================================================================

# --- 資料庫 ------------------------------------------------------------------
# 容器之間互連要用「服務名稱 + 內部 port」，不是 localhost、也不是對外映射的 port。
DATABASE_URL=postgresql://spc:請改成實際密碼@postgres:5432/spc
#
# 本機直接跑 npm run dev 時改成這樣(對外映射的 port)：
# DATABASE_URL=postgresql://spc:密碼@localhost:5431/spc
#
# 仍然要連 Neon 雲端的話貼 Neon 的連線字串即可，driver 會自動啟用 TLS：
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# --- Python SPC service ------------------------------------------------------
# 所有 SPC 統計判定都由 Python 算，這個服務連不上的話圖畫不出來。
SPC_API_BASE=http://spc-api:8000
# 本機跑 uvicorn 的話：
# SPC_API_BASE=http://127.0.0.1:8000

# --- 設定對話框密碼 -----------------------------------------------------------
# ①區齒輪的密碼保護。留空會用程式內建的預設值。
SETTINGS_PASSWORD=

# --- 連線池上限(選填) --------------------------------------------------------
# 不填預設 10。PostgreSQL 的 max_connections 有限，多個服務共用時要調小。
# PGPOOL_MAX=10
