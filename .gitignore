# --- 機密 ---------------------------------------------------------------------
.env
.env.bak.*

# --- 備份檔 -------------------------------------------------------------------
# REALDB_backup.dump 是刻意追蹤的（初始 schema + 資料），用 git add -f 加入。
# scripts/ 產生的備份則不進版控。
*.dump
backups/
# Ollama 模型匯出檔約 11 GB，絕對不能進 repo。
*.tar
*.tar.gz

# --- 相依套件與建置產物 --------------------------------------------------------
node_modules/
.next/

# --- Python 位元碼 -------------------------------------------------------------
# 這些原本被誤加進版控。編譯產物不該進 repo：會產生無意義的 diff，
# 也可能在容器內遮蔽真正的原始碼。
__pycache__/
*.py[cod]

# --- 作業系統 -----------------------------------------------------------------
.DS_Store
Thumbs.db
