# =============================================================================
#  專案根目錄環境變數範例
#  ---------------------------------------------------------------------------
#  用法：複製成 .env（同一層），填完再啟動。
#      Windows PowerShell:  Copy-Item .env.example .env
#      macOS / Linux:       cp .env.example .env
#
#  .env 已被 .gitignore 排除，不會被提交。這個 .example 檔不要放真實密碼。
# =============================================================================

# -----------------------------------------------------------------------------
#  必填
# -----------------------------------------------------------------------------

# PostgreSQL 的 postgres 使用者密碼。自己決定，但不要留空。
# 避免用 # 與 $ 這類會被 shell 解讀的字元。
DB_PASSWORD=ChangeThisToYourOwnPassword

# Pipelines API 的存取金鑰，Open WebUI 的 Aniki Pipe 用它呼叫 API。
# 建議 32 字元以上的隨機英數字。
#   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | %{[char]$_})
#   Linux/macOS: openssl rand -hex 24
ANIKI_API_KEY=please-replace-with-a-long-random-string

# -----------------------------------------------------------------------------
#  模型設定（選填）
# -----------------------------------------------------------------------------

# 檢查表辨識用的視覺語言模型
VLM_MODEL=qwen2.5vl:7b

# SPC AI 摘要用的語言模型。
# 這個值同時決定 ollama-model-init 下載哪個模型、以及 spc-api 實際呼叫哪個模型，
# 兩邊保證一致（舊版 compose 把 spc-api 的模型寫死，改這裡沒有用）。
SPC_OLLAMA_MODEL=qwen2.5:7b

# -----------------------------------------------------------------------------
#  應用程式設定（選填）
# -----------------------------------------------------------------------------

# Dashboard 設定對話框（①區齒輪）的密碼。留空則使用程式內建預設值 spc1234。
SETTINGS_PASSWORD=

# Dashboard 的 PostgreSQL 連線池上限。留空預設 10。
# PGPOOL_MAX=10

# -----------------------------------------------------------------------------
#  上游 image 版本（選填，但正式環境強烈建議鎖定）
# -----------------------------------------------------------------------------
#  預設值是浮動標籤，上游一更新就可能改變行為 —— 尤其 open-webui，
#  因為 openwebui_bootstrap.py 直接操作它的 webui.db，schema 一改就會壞。
#
#  系統驗證沒問題之後，執行下面這行把「現在正在跑的版本」鎖成 digest：
#      ./scripts/pin-upstream-images.sh
#  它會把上面四個變數改寫成 image@sha256:... 的形式寫回 .env。
# -----------------------------------------------------------------------------

POSTGRES_IMAGE=postgres:18
OLLAMA_IMAGE=ollama/ollama:latest
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
PYTHON_INIT_IMAGE=python:3.12-slim
